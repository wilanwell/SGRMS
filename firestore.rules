rules_version = '2';

// SGRMS Firestore Security Rules
//
// Roles come from users/{uid}.role ("Admin", "Teacher", "Student").
// Nobody can change their own role. SGRMS runs on the free Spark plan, so the
// Admin's phone creates and deletes accounts itself (AccountService); these
// rules make sure only an Admin can do that, only for the Teacher / Student
// roles, and never for an Admin account.
//
// Every read needs a users/{uid} profile (hasProfile), not just a login:
// deleting an account on Spark removes the profile but keeps the Auth login,
// and that login must not see anything.

service cloud.firestore {
  match /databases/{database}/documents {

    // ----- Helpers -------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(profilePath());
    }

    function me() {
      return get(profilePath()).data;
    }

    function isAdmin() {
      return hasProfile() && me().role == "Admin";
    }

    function isTeacher() {
      return hasProfile() && me().role == "Teacher";
    }

    function isStaff() {
      return isAdmin() || isTeacher();
    }

    function isStudent() {
      return hasProfile() && me().role == "Student";
    }

    function myStudentId() {
      return me().get("studentId", "");
    }

    function myTeacherId() {
      return me().get("teacherId", "");
    }

    // A teacher id that belongs to the signed-in teacher. Never matches "",
    // so an unlinked teacher account or a subject without a teacher is not "theirs".
    function isMyTeacherId(teacherId) {
      return isTeacher() && myTeacherId() != "" && teacherId == myTeacherId();
    }

    // The signed-in teacher is the assigned teacher of this subject.
    // A missing subject denies (get() of a missing document fails).
    function teachesSubject(subjectId) {
      return isMyTeacherId(get(/databases/$(database)/documents/subjects/$(subjectId)).data.get("teacherId", ""));
    }

    function isOwnStudent(studentId) {
      return isStudent() && myStudentId() != "" && studentId == myStudentId();
    }

    // Only the listed fields are changed by this update.
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // A new account profile written by an Admin (AccountService).
    function isNewAccountBy(docIdField, docId) {
      return isAdmin() && request.resource.data.get(docIdField, "") == docId;
    }

    // The given field keeps its current value.
    function unchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    // ----- users ---------------------------------------------------------

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isStaff());

      // Only an Admin creates accounts, only for teachers and students,
      // and the document id must be the new login's uid.
      allow create: if isNewAccountBy("userId", userId)
        && request.resource.data.role in ["Teacher", "Student"];

      // Admin accounts cannot be deleted from the app.
      allow delete: if isAdmin() && resource.data.role != "Admin";

      allow update: if
        // Admin may edit profiles but never change a role or a linked id.
        (isAdmin() && unchanged("role") && unchanged("userId")
          && unchanged("studentId") && unchanged("teacherId"))
        // Everyone may edit the personal fields of their own profile.
        || (request.auth.uid == userId && onlyChanges([
              "fullName", "username", "phoneNumber", "address",
              "profileNote", "profileImageUrl", "profileImageBase64", "updatedAt"
            ]))
        // A teacher may keep a student's name / email in sync.
        || (isTeacher() && resource.data.role == "Student"
            && onlyChanges(["fullName", "email", "updatedAt"]));
    }

    // ----- teachers ------------------------------------------------------

    match /teachers/{teacherId} {
      allow read: if hasProfile();
      allow create: if isNewAccountBy("teacherId", teacherId);
      allow delete: if isAdmin();

      allow update: if
        (isAdmin() && unchanged("userId") && unchanged("teacherId"))
        || (isTeacher() && teacherId == myTeacherId() && onlyChanges([
              "phoneNumber", "department", "position", "officeLocation",
              "qualification", "specialization", "address", "profileNote",
              "profileImageUrl", "profileImageBase64", "updatedAt"
            ]));
    }

    // ----- students ------------------------------------------------------

    match /students/{studentId} {
      allow read: if isStaff() || isOwnStudent(studentId);
      allow create: if isNewAccountBy("studentId", studentId);
      allow delete: if isAdmin();

      allow update: if
        (isStaff() && unchanged("userId") && unchanged("studentId"))
        || (isOwnStudent(studentId) && onlyChanges([
              "phoneNumber", "dateOfBirth", "address", "guardianName",
              "guardianPhone", "emergencyContact", "profileNote",
              "profileImageUrl", "profileImageBase64", "fcmToken", "updatedAt"
            ]));
    }

    // ----- profile photos ------------------------------------------------
    // Small JPEGs as Base64 (Spark plan has no Cloud Storage), one per user.

    match /profileImages/{userId} {
      allow read: if hasProfile();

      allow create, update: if hasProfile() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(["userId", "data", "updatedAt"])
        && request.resource.data.userId == userId
        && request.resource.data.data is string
        && request.resource.data.data.size() < 300000;

      allow delete: if hasProfile() && (request.auth.uid == userId || isAdmin());
    }

    // ----- classes & subjects -------------------------------------------

    match /classes/{classId} {
      allow read: if hasProfile();
      allow write: if isAdmin();
    }

    // A teacher manages only subjects assigned to them, and can never move a
    // subject to (or away from) themselves: grades depend on this assignment.
    match /subjects/{subjectId} {
      allow read: if hasProfile();
      allow create: if isAdmin() || isMyTeacherId(request.resource.data.get("teacherId", ""));
      allow update: if isAdmin()
        || (isMyTeacherId(resource.data.get("teacherId", ""))
            && isMyTeacherId(request.resource.data.get("teacherId", "")));
      allow delete: if isAdmin() || isMyTeacherId(resource.data.get("teacherId", ""));
    }

    // ----- grades --------------------------------------------------------

    match /grades/{gradeId} {
      // A student can only read (and query) their own grades:
      // the app must filter with whereEqualTo("studentId", <own id>).
      allow read: if isStaff() || isOwnStudent(resource.data.studentId);

      // Teachers write grades only for subjects they teach; a grade cannot be
      // moved to another subject. Admins may delete (account deletion).
      allow create: if isAdmin() || teachesSubject(request.resource.data.get("subjectId", ""));
      allow update: if isAdmin()
        || (teachesSubject(resource.data.get("subjectId", ""))
            && request.resource.data.get("subjectId", "") == resource.data.get("subjectId", ""));
      allow delete: if isAdmin() || teachesSubject(resource.data.get("subjectId", ""));
    }

    // ----- notifications -------------------------------------------------

    match /notifications/{notificationId} {
      allow read: if isStaff() || isOwnStudent(resource.data.studentId);
      allow create: if isStaff();

      allow update: if isStaff()
        || (isOwnStudent(resource.data.studentId)
            && onlyChanges(["isRead", "read"]));

      allow delete: if isStaff() || isOwnStudent(resource.data.studentId);
    }

    // ----- reports -------------------------------------------------------

    match /reportRemarks/{studentId} {
      allow read: if isStaff() || isOwnStudent(studentId);
      allow write: if isStaff();
    }

    match /reports/{reportId} {
      allow read: if isStaff() || isOwnStudent(resource.data.studentId);
      allow write: if isStaff();
    }

    // Everything else is denied by default.
  }
}
