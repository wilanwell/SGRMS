rules_version = '2';

// SGRMS Cloud Storage rules
//
// Profile photos live at profile_images/{userId}.jpg, where userId is the
// Firebase Auth uid of the account the photo belongs to. Only that user can
// replace or remove their photo; any signed-in user can view photos.

service firebase.storage {
  match /b/{bucket}/o {

    match /profile_images/{fileName} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
        && fileName == request.auth.uid + ".jpg"
        && (request.resource == null || (
              request.resource.size < 2 * 1024 * 1024
              && request.resource.contentType.matches("image/.*")
           ));
    }

    // Everything else is denied by default.
  }
}
